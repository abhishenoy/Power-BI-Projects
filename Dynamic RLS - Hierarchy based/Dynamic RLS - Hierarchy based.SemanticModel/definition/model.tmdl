model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Hierarchy table","Sales table"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Hierarchy table'
ref table 'Sales table'

ref role Untitled

ref cultureInfo en-US

